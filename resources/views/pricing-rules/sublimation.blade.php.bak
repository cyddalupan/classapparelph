        body { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); min-height: 100vh; padding: 20px; }
        .rule-card { background: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); padding: 25px; margin-top: 20px; }
        .header-card { background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 15px; padding: 25px 30px; color: white; margin-top: 20px; }
        .nav-tabs .nav-link { color: #059669; font-weight: 600; border: none; padding: 12px 25px; }
        .nav-tabs .nav-link.active { color: white; background: #059669; border-radius: 10px 10px 0 0; }
        .section-title { color: #047857; border-left: 4px solid #059669; padding-left: 15px; margin: 25px 0 15px 0; font-weight: 600; }
        .price-input { border: 2px solid #e2e8f0; border-radius: 8px; padding: 8px 12px; font-weight: 600; text-align: right; width: 120px; transition: all 0.3s; }
        .price-input:focus { border-color: #059669; box-shadow: 0 0 0 3px rgba(5,150,105,0.1); outline: none; }
        .item-row { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 15px; margin-bottom: 8px; transition: all 0.2s; }
        .item-row:hover { border-color: #059669; background: #f0fdf4; }
        .item-row.linked { border-left: 4px solid #059669; background: #f0fdf4; }
        .bulk-row { background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 12px 15px; margin-bottom: 8px; }
        .btn-save { background: linear-gradient(135deg, #059669 0%, #047857 100%); color: white; border: none; border-radius: 10px; padding: 12px 30px; font-size: 1.1rem; font-weight: 600; }
        .btn-save:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(5,150,105,0.3); }
        .btn-add { background: #059669; color: white; border: none; border-radius: 8px; padding: 8px 20px; font-weight: 600; }
        .btn-add:hover { background: #047857; }
        .btn-remove { background: #ef4444; color: white; border: none; border-radius: 6px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; }
        .btn-remove:hover { background: #dc2626; }
        .badge-category { font-size: 0.8rem; padding: 4px 10px; border-radius: 20px; }
        .badge-garment { background: #dbeafe; color: #1d4ed8; }
        .badge-fabric { background: #fce7f3; color: #be185d; }
        .badge-part { background: #fef3c7; color: #b45309; }
        .badge-linked { background: #d1fae5; color: #047857; font-size: 0.75rem; }
        .tab-pane { padding-top: 20px; }
        .master-select { border: 2px solid #e2e8f0; border-radius: 8px; font-size: 0.85rem; }
        .master-select option { padding: 4px; }
        .auto-fill-badge { background: #059669; color: white; font-size: 0.7rem; padding: 2px 8px; border-radius: 10px; }
    </style>
</head>
