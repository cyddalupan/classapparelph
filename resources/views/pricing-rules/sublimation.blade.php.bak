    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function showAddForm(category, tabGroup) {
            document.getElementById('addCategory').value = category;
            document.getElementById('addTabGroup').value = tabGroup;
            const modal = new bootstrap.Modal(document.getElementById('addItemModal'));
            modal.show();
        }

        function autoFillPrice(selectEl, itemId) {
            const selected = selectEl.options[selectEl.selectedIndex];
            if (selected && selected.value) {
                const salesPrice = selected.dataset.sales;
                const agentPrice = selected.dataset.agent;
                
                // Find the parent item-row
                const row = selectEl.closest('.item-row');
                if (row && salesPrice) {
                    const priceInput = row.querySelector('input[name*="[price]"]');
                    if (priceInput) {
                        priceInput.value = salesPrice;
                        priceInput.style.borderColor = '#059669';
                        priceInput.style.backgroundColor = '#f0fdf4';
                    }
                }
                if (row && agentPrice) {
                    const agentInput = row.querySelector('input[name*="[agent_price]"]');
                    if (agentInput) {
                        agentInput.value = agentPrice;
                    }
                }
            }
        }

        // Auto-highlight linked items on page load
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.master-select').forEach(function(select) {
                if (select.value) {
                    const row = select.closest('.item-row');
                    if (row) {
                        const priceInput = row.querySelector('input[name*="[price]"]');
                        if (priceInput && priceInput.value) {
                            priceInput.style.borderColor = '#059669';
                            priceInput.style.backgroundColor = '#f0fdf4';
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>
